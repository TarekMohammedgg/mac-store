# Admin (seeded in Supabase Auth + profiles; shorthand "admin" maps to the email)
NEXT_PUBLIC_DEFAULT_ADMIN_USERNAME="admin"
NEXT_PUBLIC_DEFAULT_ADMIN_EMAIL="admin@macstore.local"
NEXT_PUBLIC_DEFAULT_ADMIN_PASSWORD="admin1234"

# Supabase (Dashboard → Connect, or Settings → API Keys)
# On Vercel: Project Settings → Environment Variables → add both for Production + Preview
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
